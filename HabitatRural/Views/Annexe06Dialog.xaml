<Window x:Class="HabitatRural.Views.Annexe06Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الملحق 06 – محضر معاينة أشغال السكن الريفي"
        Width="780" Height="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}"
                Padding="20,14" Margin="0,0,0,0">
            <StackPanel>
                <TextBlock Text="ANNEXE N° 06  –  محضر معاينة أشغال السكن الريفي"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           FontFamily="Segoe UI, Arial"/>
                <TextBlock x:Name="TxtBeneficiaireInfo"
                           Foreground="#BBDEFB" FontSize="12" Margin="0,4,0,0"
                           FontFamily="Segoe UI, Arial"/>
            </StackPanel>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <!-- Bloc info institution -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                   Text="بيانات المفتشية" FontWeight="Bold" FontSize="13"
                                   Margin="0,0,0,10" Foreground="{StaticResource PrimaryBrush}"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="الولاية (Direction Logement)" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtDirectionLogement" Style="{StaticResource FormTextBox}"
                                     Text="MEDEA"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="الدائرة (Daïra)" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtDaira" Style="{StaticResource FormTextBox}"
                                     Text="TABLAT"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0">
                            <TextBlock Text="البلدية (Commune)" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtCommune" Style="{StaticResource FormTextBox}"
                                     Text="DEUX BASSINS"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,0">
                            <TextBlock Text="المهندس المتابع" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="CbIngenieur"
                                      Style="{StaticResource FormComboBox}"
                                      IsEditable="False"
                                      SelectionChanged="CbIngenieur_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0">
                            <TextBlock Text="تاريخ المعاينة" Style="{StaticResource FormLabel}"/>
                            <DatePicker x:Name="DpDateVisite"
                                        Style="{StaticResource FormDatePicker}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bloc infos chantier -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                   Text="بيانات ورشة البناء" FontWeight="Bold" FontSize="13"
                                   Margin="0,0,0,10" Foreground="{StaticResource PrimaryBrush}"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="الفرقة / موقع المشروع" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtFractionProjet" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="رقم رخصة البناء (Permis de construire)" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtNumeroPermis" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,0">
                            <TextBlock Text="تاريخ رخصة البناء" Style="{StaticResource FormLabel}"/>
                            <DatePicker x:Name="DpDatePermis"
                                        Style="{StaticResource FormDatePicker}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Rubriques Table -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="جدول الإنجازات المعاينة"
                                       FontWeight="Bold" FontSize="13"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Content="＋  إضافة سطر"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnAddRubrique_Click"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,0" Padding="10,6"/>
                        </DockPanel>

                        <!-- Table header -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="6,6,0,0" Padding="4,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RUBRIQUE" Foreground="White"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="EN CHIFFRE" Foreground="White"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="EN LETTRES" Foreground="White"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="OBS." Foreground="White"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="" Foreground="White"/>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="IcRubriques">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Rubrique, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBox}"
                                                     Margin="2"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding EnChiffre, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBox}"
                                                     TextAlignment="Center" Margin="2"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding EnLettres, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBox}"
                                                     Margin="2"/>
                                            <CheckBox Grid.Column="3"
                                                      IsChecked="{Binding HasObservation}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Content="×" FontSize="14"/>
                                            <Button Grid.Column="4"
                                                    Content="🗑" FontSize="13"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="BtnDeleteRubrique_Click"
                                                    Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Tranches -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الشريحة المُحقّ فيها المستفيد"
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkTranche1"
                                      Content="الشريحة الأولى  (60% من المبلغ)"
                                      FontSize="13" Margin="0,0,30,0"/>
                            <CheckBox x:Name="ChkTranche2"
                                      Content="الشريحة الثانية  (40% من المبلغ)"
                                      FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Observations & signatures -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                   Text="ملاحظات وتوقيع" FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <TextBlock Text="ملاحظات إضافية (Observations complémentaires)"
                                       Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtObservations"
                                     Style="{StaticResource FormTextBox}"
                                     AcceptsReturn="True" Height="60"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="اسم الموقّع" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtNomSignataire"
                                     Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="المكان (Lieu)" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtLieu" Style="{StaticResource FormTextBox}"
                                     Text="DEUX BASSINS"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="تاريخ المحضر" Style="{StaticResource FormLabel}"/>
                            <DatePicker x:Name="DpDatePV"
                                        Style="{StaticResource FormDatePicker}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="White" Padding="16,10"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="💾  حفظ" Style="{StaticResource SuccessButton}"
                        Click="BtnSave_Click" MinWidth="110" Margin="0,0,10,0"/>
                <Button Content="🖨  معاينة وطباعة" Style="{StaticResource PrimaryButton}"
                        Click="BtnPreview_Click" MinWidth="150" Margin="0,0,10,0"/>
                <Button Content="📄  تصدير Word" Style="{StaticResource SecondaryButton}"
                        Click="BtnExportWord_Click" MinWidth="130" Margin="0,0,10,0"/>
                <Button Content="✖  إلغاء" Style="{StaticResource SecondaryButton}"
                        Click="BtnCancel_Click" MinWidth="90"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
