<Window x:Class="HabitatRural.Views.BeneficiaireEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات المستفيد"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <TextBlock Text="📋  بيانات المستفيد – السكن الريفي 2026"
                       Foreground="White" FontSize="15" FontWeight="Bold"
                       FontFamily="Segoe UI, Arial"/>
        </Border>

        <!-- Form fields -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Code -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="رمز المستفيد" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtCode" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <!-- Nom Prénom -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="الاسم واللقب (كما في الوثائق الرسمية)" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtNomPrenom" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <!-- Adresse -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="العنوان / الفرقة" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtAdresse" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <!-- Fraction -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="الفرقة (FRACTION)" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtFraction" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <!-- Numero Décision -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="رقم القرار (N° décision)" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtNumeroDecision" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <!-- Date Décision -->
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="تاريخ القرار" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="DpDateDecision"
                                Style="{StaticResource FormDatePicker}"
                                SelectedDateFormat="Short"/>
                </StackPanel>

                <!-- Montant -->
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="مبلغ المساعدة (دج)" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtMontant" Style="{StaticResource FormTextBox}"
                             Text="700000"/>
                </StackPanel>

                <!-- Commune -->
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="البلدية" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtCommune" Style="{StaticResource FormTextBox}"
                             Text="DEUX BASSINS"/>
                </StackPanel>

                <!-- Localisation Projet -->
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="موقع المشروع (localisation)" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtLocalisationProjet" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <!-- Fraction Projet -->
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="فرقة المشروع" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtFractionProjet" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <!-- Numéro Compte -->
                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="رقم الحساب البنكي" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtNumeroCompte" Style="{StaticResource FormTextBox}"/>
                </StackPanel>

                <!-- Banque Agence -->
                <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="البنك / الوكالة" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="CbBanqueAgence"
                              Style="{StaticResource FormComboBox}"
                              IsEditable="True">
                        <ComboBoxItem Content="BADR"/>
                        <ComboBoxItem Content="BNA"/>
                        <ComboBoxItem Content="CPA"/>
                        <ComboBoxItem Content="BDL"/>
                        <ComboBoxItem Content="CCP"/>
                        <ComboBoxItem Content="CNEP"/>
                        <ComboBoxItem Content="AGB"/>
                    </ComboBox>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="BtnSave" Content="💾  حفظ"
                    Style="{StaticResource SuccessButton}"
                    Click="BtnSave_Click" MinWidth="120" Margin="0,0,10,0"/>
            <Button Content="✖  إلغاء"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
